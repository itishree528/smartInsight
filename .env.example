# SmartInsight Root Environment Configuration

# Database (pgvector PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/smartinsight_db

# Redis Caching
REDIS_URL=redis://localhost:6379/0

# LLM & Embeddings (Optional - mock mode runs if key is not provided)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
MOCK_LLM_IF_NO_KEY=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
