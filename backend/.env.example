# Database (pgvector enabled PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartinsight_db

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_EXPIRATION_SECONDS=3600

# OpenAI (Optional - mock mode activates if omitted for instant zero-cost local testing)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
MOCK_LLM_IF_NO_KEY=true

# RAG & Chunking
CHUNK_SIZE=600
CHUNK_OVERLAP=120
TOP_K_CHUNKS=4
TARGET_TTFT_MS=350
